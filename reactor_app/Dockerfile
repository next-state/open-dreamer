# syntax=docker/dockerfile:1
# check=skip=FromPlatformFlagConstDisallowed
# Reactor model — Dockerfile baseline.
#
# Generated by `reactor init`. Edit freely; this is a starting point.
#
# The `reactor` Go CLI builds and runs this image for you (`reactor run`,
# `reactor model publish`, …) — you normally don't invoke docker directly.
# The equivalent docker commands are shown for transparency and one-off
# debugging:
#
#   docker build -t my-model:dev .
#   docker run --rm -p 8080:8080 my-model:dev

# The runtime-base tag below is pinned by `reactor init`. Bump it manually
# to upgrade the runtime; reactor releases are pinned to immutable tags —
# there is no `latest`.
#
# The base image ships:
#   - GStreamer + gst-plugins-rs under /usr (WebRTC transport, codecs, …)
#   - A pre-baked Python venv at /opt/venv with reactor-runtime[gst]
#     pre-installed; PATH puts /opt/venv/bin first so plain `python` and
#     `pip` resolve into the venv automatically.
#   - tini at /usr/bin/tini for the entrypoint below.
#
# --platform=linux/amd64: the runtime-base image is currently published for
# x86_64 only. On Apple Silicon (arm64) Docker Desktop provides transparent
# QEMU emulation so `reactor build` / `reactor run` still work, just slower.
# Remove this flag once a native arm64 image is published.
#
# To layer CUDA / NVIDIA GPU support on top, see
# containers/reactor-runtime-base/README.md.
FROM --platform=linux/amd64 reactortechnologies/reactor-runtime-base:2.7.1-0

WORKDIR /app

ENV JAVA_HOME=/opt/java
ENV PATH=/opt/java/bin:$PATH

# --- MineRL system/runtime dependencies ---------------------------------
# MineRL builds and launches a Minecraft/Malmo runtime. Its installer needs a
# JDK and the runtime needs a display; Xvfb provides one in headless containers.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git patch xauth xvfb \
    && (apt-get install -y --no-install-recommends openjdk-8-jdk \
        || apt-get install -y --no-install-recommends openjdk-11-jdk \
        || apt-get install -y --no-install-recommends openjdk-17-jdk \
        || apt-get install -y --no-install-recommends default-jdk) \
    && detected_java_home="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")" \
    && ln -s "$detected_java_home" "$JAVA_HOME" \
    && java -version \
    && javac -version \
    && rm -rf /var/lib/apt/lists/*

# --- App install ---------------------------------------------------------
COPY reactor_app/requirements.txt /app/reactor_app/requirements.txt
RUN pip install --no-cache-dir -r /app/reactor_app/requirements.txt \
    && pip install --no-cache-dir --no-deps \
        "minerl @ git+https://github.com/minerllabs/minerl@cdeae668c2f334e3c9117adf651b5a94436b45f8"

# --- Reactor workspace ---------------------------------------------------
COPY reactor_app /app/reactor_app

# reactor.yaml is in the workspace subdir, so cd there before serving.
WORKDIR /app/reactor_app

# --- Entrypoint ----------------------------------------------------------
ENTRYPOINT ["/usr/bin/tini", "--", "xvfb-run", "-a", "python", "-m", "reactor_runtime.serve"]
CMD ["run"]
